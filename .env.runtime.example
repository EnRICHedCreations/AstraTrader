# Copy to .env.runtime. Never commit the populated file.
TRADING_MODE=paper
ADMIN_TOKEN=
INGEST_TOKEN=
SIGNER_TOKEN=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=
POLL_MS=1000
PAPER_BALANCE_USDC=1000
SIGNER_ENABLE_LIVE=false
LIVE_BUDGET_USDC=0
LIVE_MAX_ORDER_USDC=0
LIVE_DAILY_BUY_LIMIT_USDC=0
LIVE_DAILY_LOSS_LIMIT_USDC=0
LIVE_APPROVAL_SHA256=
MAX_SLIPPAGE_BPS=50
MAX_NATIVE_COST_LAMPORTS=5000000
MIN_SOL_RESERVE_LAMPORTS=10000000
DISCOVERY_PROGRAMS=JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4
# Hosted paper mode: run db/supabase-runtime.sql, then use these instead of DATABASE_PATH.
PERSISTENCE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PERSISTENCE_CONFIRMED=false
# SQLite alternative only:
DATABASE_PATH=
DISABLE_DISCOVERY=true
SIGNER_TRANSPORT=pull
# Leave all signing key variables unset on the web project.
