# Copy to .env.runtime. Never commit the populated file.
TRADING_MODE=paper
ADMIN_TOKEN=
INGEST_TOKEN=
SIGNER_TOKEN=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=
POLL_MS=1000
PAPER_BALANCE_USDC=1000
# No real-money budget is assumed. These zero values intentionally block signing.
SIGNER_ENABLE_LIVE=false
LIVE_BUDGET_USDC=0
LIVE_MAX_ORDER_USDC=0
LIVE_DAILY_BUY_LIMIT_USDC=0
LIVE_DAILY_LOSS_LIMIT_USDC=0
LIVE_APPROVAL_SHA256=
MAX_SLIPPAGE_BPS=50
MAX_NATIVE_COST_LAMPORTS=5000000
MIN_SOL_RESERVE_LAMPORTS=10000000
# Comma-separated DEX program addresses; the default is Jupiter v6.
DISCOVERY_PROGRAMS=JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4
# Deploy Hatch / direct Node startup: these must refer to real durable storage.
DATABASE_PATH=
PERSISTENCE_CONFIRMED=false
# Set true when the separate astratraderworker project is collecting.
DISABLE_DISCOVERY=false
# For the Deploy Hatch worker's outbound signer transport:
SIGNER_TRANSPORT=pull
# Leave the signing key unset on the web project.
